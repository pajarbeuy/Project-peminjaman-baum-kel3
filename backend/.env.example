PORT=3000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=peminjaman_ukri

# JWT — WAJIB diganti dengan nilai acak yang kuat di setiap environment
